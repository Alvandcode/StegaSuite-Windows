<Window x:Class="StegaSuite.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" Height="440" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        FontFamily="Segoe UI" FontSize="13">
  <Border CornerRadius="20" Background="{DynamicResource CardBrush}"
          BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
          Padding="18,14" Margin="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="LblHistTitle" FontSize="17" FontWeight="Bold"
                 Foreground="{DynamicResource TextBrush}"/>
      <ListBox x:Name="LstHist" Grid.Row="1" Margin="0,12,0,0" FontSize="12.5"
               Background="{DynamicResource FieldBrush}"
               BorderBrush="{DynamicResource FieldBorderBrush}"
               Foreground="{DynamicResource FieldFgBrush}"/>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0"
                  HorizontalAlignment="Right">
        <Button x:Name="BtnClearHist" Style="{StaticResource PillButton}"
                MinWidth="140" Height="40" Padding="14,0" Margin="0,0,8,0" Click="BtnClearHist_Click"/>
        <Button x:Name="BtnCloseHist" Style="{StaticResource PillButton}"
                MinWidth="100" Height="40" Padding="14,0" Content="✕" Click="BtnCloseHist_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
