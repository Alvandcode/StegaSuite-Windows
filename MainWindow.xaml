<Window x:Class="StegaSuite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StegaSuite — Windows" Width="900" Height="760"
        Icon="Assets/app.ico"
        MinWidth="740" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="13">
  <Grid>
   <Border CornerRadius="26" Background="{DynamicResource SurfaceBrush}" Margin="12">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ══ Sidebar rail ══ -->
      <Border x:Name="SidebarCard" Grid.Column="0" CornerRadius="30" Background="{DynamicResource SidebarBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
              Margin="10" Padding="8" Width="88">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="62"/>
            <RowDefinition Height="62"/>
            <RowDefinition Height="62"/>
            <RowDefinition Height="62"/>
            <RowDefinition Height="62"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Button x:Name="Nav0" Grid.Row="0" Style="{StaticResource NavButton}" Content="&#xE80F;"
                  FontFamily="Segoe MDL2 Assets" FontSize="19" Margin="6,3" Tag="0" Click="Nav_Click"/>
          <Button x:Name="Nav1" Grid.Row="1" Style="{StaticResource NavButton}" Content="&#xE896;"
                  FontFamily="Segoe MDL2 Assets" FontSize="19" Margin="6,3" Tag="1" Click="Nav_Click"/>
          <Button x:Name="Nav2" Grid.Row="2" Style="{StaticResource NavButton}" Content="&#xE946;"
                  FontFamily="Segoe MDL2 Assets" FontSize="19" Margin="6,3" Tag="2" Click="Nav_Click"/>
          <Button x:Name="Nav3" Grid.Row="3" Style="{StaticResource NavButton}" Content="&#xE715;"
                  FontFamily="Segoe MDL2 Assets" FontSize="19" Margin="6,3" Tag="3" Click="Nav_Click"/>
          <Button x:Name="Nav4" Grid.Row="4" Style="{StaticResource NavButton}" Content="&#xE734;"
                  FontFamily="Segoe MDL2 Assets" FontSize="19" Margin="6,3" Tag="4" Click="Nav_Click"/>
          <Button x:Name="Nav5" Grid.Row="5" Style="{StaticResource NavButton}" Content="&#xE713;"
                  FontFamily="Segoe MDL2 Assets" FontSize="19" Margin="6,3" Tag="5" Click="Nav_Click"/>
        </Grid>
      </Border>

      <!-- ══ Content ══ -->
      <Grid x:Name="ContentGrid" Grid.Column="1" Margin="0,10,10,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hero -->
        <Border Grid.Row="0" CornerRadius="24" Background="{DynamicResource HeroBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="20,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock x:Name="LblTitle" FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="LblSub" FontSize="13" Margin="0,4,0,0" LineHeight="20"
                           LineStackingStrategy="BlockLineHeight"
                           Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap"/>
              </StackPanel>
              <Border Grid.Column="1" CornerRadius="16" Background="{DynamicResource WindowBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                      Padding="12,10" MinWidth="170" MaxWidth="250" VerticalAlignment="Center">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10"
                             Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LblStatusCap" FontWeight="Bold" FontSize="12" Margin="8,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource SubBrush}"/>
                  </StackPanel>
                  <TextBlock x:Name="LblStatus" FontSize="12.5" Margin="0,6,0,0" LineHeight="19"
                             LineStackingStrategy="BlockLineHeight"
                             Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
          </Grid>
        </Border>

        <!-- Pages -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
          <Grid x:Name="PagesHost">

            <!-- HOME (hide) -->
            <Grid x:Name="Page0" Visibility="Visible">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="20" Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        Padding="18,14" Margin="0,0,6,0">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#x1F4C2;" FontSize="16" VerticalAlignment="Center"/>
                      <TextBlock x:Name="LblCarrierH" FontWeight="Bold" FontSize="15" Margin="8,0,0,0"
                                 VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                    <Border CornerRadius="14" Background="{DynamicResource FieldBrush}"
                            BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1"
                            Margin="0,10,0,0" Padding="14,0">
                      <TextBox x:Name="FCarrierH" Background="Transparent" BorderThickness="0" Height="42"
                               VerticalContentAlignment="Center" AllowDrop="True"
                               Foreground="{DynamicResource FieldFgBrush}"
                               Drop="PathBox_Drop" PreviewDragOver="PathBox_DragOver"
                               TextChanged="FCarrierH_TextChanged"/>
                    </Border>
                    <Button x:Name="BtnBrowseCH" Style="{StaticResource PillButton}" Height="40" Margin="0,10,0,0" Click="BtnBrowseCH_Click"/>
                    <TextBlock x:Name="LblCapH" FontSize="11.5" Margin="6,8,0,0" MinHeight="16"
                               Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" CornerRadius="20" Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        Padding="18,14" Margin="6,0,0,0">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#x1F4C4;" FontSize="16" VerticalAlignment="Center"/>
                      <TextBlock x:Name="LblPayloadH" FontWeight="Bold" FontSize="15" Margin="8,0,0,0"
                                 VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                    <Border CornerRadius="14" Background="{DynamicResource FieldBrush}"
                            BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1"
                            Margin="0,10,0,0" Padding="14,0">
                      <TextBox x:Name="FPayload" Background="Transparent" BorderThickness="0" Height="42"
                               VerticalContentAlignment="Center" AllowDrop="True"
                               Foreground="{DynamicResource FieldFgBrush}"
                               Drop="PathBox_Drop" PreviewDragOver="PathBox_DragOver"
                               TextChanged="FPayload_TextChanged"/>
                    </Border>
                    <Button x:Name="BtnBrowseP" Style="{StaticResource PillButton}" Height="40" Margin="0,10,0,0" Click="BtnBrowseP_Click"/>
                    <TextBlock x:Name="LblPayloadHint" FontSize="11.5" Margin="6,8,0,0" MinHeight="16"
                               Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </Grid>
              <Border Grid.Row="1" CornerRadius="20" Background="{DynamicResource CardBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                      Padding="18,14" Margin="0,12,0,0">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F511;" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LblPassH" FontWeight="Bold" FontSize="15" Margin="8,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                  </StackPanel>
                  <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="14" Background="{DynamicResource FieldBrush}"
                            BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" Padding="14,0">
                      <Grid>
                        <PasswordBox x:Name="FPassH" Background="Transparent" BorderThickness="0" Height="42"
                                     VerticalContentAlignment="Center" Foreground="{DynamicResource FieldFgBrush}"
                                     PasswordChanged="FPassH_Changed"/>
                        <TextBox x:Name="FPassHShow" Background="Transparent" BorderThickness="0" Height="42"
                                 VerticalContentAlignment="Center" Foreground="{DynamicResource FieldFgBrush}"
                                 Visibility="Collapsed" TextChanged="FPassHShow_Changed"/>
                      </Grid>
                    </Border>
                    <CheckBox x:Name="ChkShowH" Grid.Column="1" MinWidth="90" Margin="10,0,0,0"
                              VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"
                              Checked="ChkShowH_Changed" Unchecked="ChkShowH_Changed"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Button x:Name="BtnGoHide" Grid.Row="2" Style="{StaticResource PillButton}" Height="58"
                      FontSize="15.5" Margin="0,12,0,0"
                      Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentFgBrush}"
                      Click="BtnGoHide_Click">
                <Button.Effect>
                  <DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="14" ShadowDepth="0"/>
                </Button.Effect>
              </Button>
              <ProgressBar x:Name="PbHide" Grid.Row="3" Height="6" Margin="0,10,0,0"
                           Minimum="0" Maximum="100" BorderThickness="0"
                           Background="{DynamicResource FieldBrush}"
                           Foreground="{DynamicResource AccentBrush}"
                           Visibility="Collapsed"/>
            </Grid>

            <!-- EXTRACT -->
            <Grid x:Name="Page1" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" CornerRadius="20" Background="{DynamicResource CardBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="18,14">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F4C2;" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LblCarrierE" FontWeight="Bold" FontSize="15" Margin="8,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                  </StackPanel>
                  <Border CornerRadius="14" Background="{DynamicResource FieldBrush}"
                          BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1"
                          Margin="0,10,0,0" Padding="14,0">
                    <TextBox x:Name="FCarrierE" Background="Transparent" BorderThickness="0" Height="42"
                             VerticalContentAlignment="Center" AllowDrop="True"
                             Foreground="{DynamicResource FieldFgBrush}"
                             Drop="PathBox_Drop" PreviewDragOver="PathBox_DragOver"
                             TextChanged="FCarrierE_TextChanged"/>
                  </Border>
                  <Button x:Name="BtnBrowseCE" Style="{StaticResource PillButton}" Height="40" Margin="0,10,0,0" Click="BtnBrowseCE_Click"/>
                  <TextBlock x:Name="LblCapE" FontSize="11.5" Margin="6,8,0,0" MinHeight="16"
                             Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <Border Grid.Row="1" CornerRadius="20" Background="{DynamicResource CardBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                      Padding="18,14" Margin="0,12,0,0">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F511;" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LblPassE" FontWeight="Bold" FontSize="15" Margin="8,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                  </StackPanel>
                  <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="14" Background="{DynamicResource FieldBrush}"
                            BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" Padding="14,0">
                      <Grid>
                        <PasswordBox x:Name="FPassE" Background="Transparent" BorderThickness="0" Height="42"
                                     VerticalContentAlignment="Center" Foreground="{DynamicResource FieldFgBrush}"
                                     PasswordChanged="FPassE_Changed"/>
                        <TextBox x:Name="FPassEShow" Background="Transparent" BorderThickness="0" Height="42"
                                 VerticalContentAlignment="Center" Foreground="{DynamicResource FieldFgBrush}"
                                 Visibility="Collapsed" TextChanged="FPassEShow_Changed"/>
                      </Grid>
                    </Border>
                    <CheckBox x:Name="ChkShowE" Grid.Column="1" MinWidth="90" Margin="10,0,0,0"
                              VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"
                              Checked="ChkShowE_Changed" Unchecked="ChkShowE_Changed"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Button x:Name="BtnGoExtract" Grid.Row="2" Style="{StaticResource PillButton}" Height="58"
                      FontSize="15.5" Margin="0,12,0,0"
                      Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentFgBrush}"
                      Click="BtnGoExtract_Click">
                <Button.Effect>
                  <DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="14" ShadowDepth="0"/>
                </Button.Effect>
              </Button>
              <ProgressBar x:Name="PbExtract" Grid.Row="3" Height="6" Margin="0,10,0,0"
                           Minimum="0" Maximum="100" BorderThickness="0"
                           Background="{DynamicResource FieldBrush}"
                           Foreground="{DynamicResource AccentBrush}"
                           Visibility="Collapsed"/>
            </Grid>

            <!-- ABOUT -->
            <Grid x:Name="Page2" Visibility="Collapsed">
              <Border CornerRadius="20" Background="{DynamicResource CardBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="22,18">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="LblAboutTitle" FontWeight="Bold" FontSize="20" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                  </StackPanel>
                  <TextBlock x:Name="LblAboutDesc" FontSize="13.5" Margin="0,14,0,0" LineHeight="24"
                             LineStackingStrategy="BlockLineHeight"
                             Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                  <TextBlock x:Name="LblFeatures" FontSize="13.5" Margin="0,14,0,0" LineHeight="28"
                             LineStackingStrategy="BlockLineHeight"
                             Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                  <TextBlock Margin="0,16,0,0" FontSize="13.5">
                    <Hyperlink NavigateUri="https://alvandcode.github.io/StegaSuite/tutorial.html"
                               RequestNavigate="Link_RequestNavigate"
                               Foreground="{DynamicResource LinkBrush}" FontWeight="Bold">
                      <Run x:Name="RunTutorial"/>
                    </Hyperlink>
                  </TextBlock>
                </StackPanel>
              </Border>
            </Grid>

            <!-- CONTACT -->
            <Grid x:Name="Page3" Visibility="Collapsed">
              <Border CornerRadius="20" Background="{DynamicResource CardBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="22,18">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="LblContactTitle" FontWeight="Bold" FontSize="20" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <TextBlock Text="&#x1F419;" FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13">
                      <Hyperlink NavigateUri="https://github.com/Alvandcode/StegaSuite"
                                 RequestNavigate="Link_RequestNavigate"
                                 Foreground="{DynamicResource LinkBrush}">https://github.com/Alvandcode/StegaSuite</Hyperlink>
                    </TextBlock>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="&#x1F4E8;" FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13">
                      <Hyperlink NavigateUri="https://t.me/a_c_official"
                                 RequestNavigate="Link_RequestNavigate"
                                 Foreground="{DynamicResource LinkBrush}">https://t.me/a_c_official</Hyperlink>
                    </TextBlock>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="&#x1F310;" FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13">
                      <Hyperlink NavigateUri="https://alvandcode.github.io"
                                 RequestNavigate="Link_RequestNavigate"
                                 Foreground="{DynamicResource LinkBrush}">https://alvandcode.github.io</Hyperlink>
                    </TextBlock>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>

            <!-- SUPPORT -->
            <Grid x:Name="Page4" Visibility="Collapsed">
              <Border CornerRadius="20" Background="{DynamicResource CardBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="22,18">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="LblSupportTitle" FontWeight="Bold" FontSize="20" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                  </StackPanel>
                  <TextBlock x:Name="LblSupportStar" FontSize="13.5" Margin="0,12,0,0" LineHeight="24"
                             LineStackingStrategy="BlockLineHeight"
                             Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                  <Button x:Name="BtnStar" Style="{StaticResource PillButton}" Height="46" Margin="0,12,0,0"
                          Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentFgBrush}"
                          Click="BtnStar_Click">
                    <Button.Effect>
                      <DropShadowEffect Color="Black" Opacity="0.22" BlurRadius="12" ShadowDepth="0"/>
                    </Button.Effect>
                  </Button>
                  <TextBlock x:Name="LblWalletCap" FontSize="12.5" Margin="0,16,0,0"
                             Foreground="{DynamicResource SubBrush}"/>
                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="14" Background="{DynamicResource FieldBrush}"
                            BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" Padding="14,0">
                      <TextBox x:Name="FWallet" Background="Transparent" BorderThickness="0" Height="42"
                               VerticalContentAlignment="Center" IsReadOnly="True"
                               Foreground="{DynamicResource FieldFgBrush}" FontSize="11"/>
                    </Border>
                    <Button x:Name="BtnCopy" Grid.Column="1" Style="{StaticResource PillButton}"
                            MinWidth="110" Height="42" Padding="14,0" Margin="8,0,0,0" Click="BtnCopy_Click"/>
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>

            <!-- SETTINGS -->
            <Grid x:Name="Page5" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" CornerRadius="20" Background="{DynamicResource CardBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                      Padding="18,14" Margin="0,0,0,12">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F310;" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LblLangCap" FontWeight="Bold" FontSize="15" Margin="8,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                  </StackPanel>
                  <WrapPanel x:Name="FlowLangs" Margin="0,12,0,0">
                    <Button x:Name="Lang0" Style="{StaticResource PillButton}" Width="118" Height="42" Margin="0,0,8,8" Tag="0" Click="Lang_Click">فارسی</Button>
                    <Button x:Name="Lang1" Style="{StaticResource PillButton}" Width="118" Height="42" Margin="0,0,8,8" Tag="1" Click="Lang_Click">العربية</Button>
                    <Button x:Name="Lang2" Style="{StaticResource PillButton}" Width="118" Height="42" Margin="0,0,8,8" Tag="2" Click="Lang_Click">English</Button>
                    <Button x:Name="Lang3" Style="{StaticResource PillButton}" Width="118" Height="42" Margin="0,0,8,8" Tag="3" Click="Lang_Click">Русский</Button>
                    <Button x:Name="Lang4" Style="{StaticResource PillButton}" Width="118" Height="42" Margin="0,0,8,8" Tag="4" Click="Lang_Click">中文</Button>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Grid.Row="1" CornerRadius="20" Background="{DynamicResource CardBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                      Padding="18,14" Margin="0,0,0,12">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F319;" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LblDarkGroup" FontWeight="Bold" FontSize="15" Margin="8,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                  </StackPanel>
                  <WrapPanel x:Name="FlowDark" Margin="0,12,0,0">
                    <Button x:Name="Theme0" Style="{StaticResource PillButton}" Width="190" Height="42" Margin="0,0,8,8" Tag="0" Click="Theme_Click"/>
                    <Button x:Name="Theme1" Style="{StaticResource PillButton}" Width="190" Height="42" Margin="0,0,8,8" Tag="1" Click="Theme_Click"/>
                    <Button x:Name="Theme2" Style="{StaticResource PillButton}" Width="190" Height="42" Margin="0,0,8,8" Tag="2" Click="Theme_Click"/>
                    <Button x:Name="Theme6" Style="{StaticResource PillButton}" Width="190" Height="42" Margin="0,0,8,8" Tag="6" Click="Theme_Click"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Grid.Row="2" CornerRadius="20" Background="{DynamicResource CardBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                      Padding="18,14">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F31E;" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LblLightGroup" FontWeight="Bold" FontSize="15" Margin="8,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                  </StackPanel>
                  <WrapPanel x:Name="FlowLight" Margin="0,12,0,0">
                    <Button x:Name="Theme3" Style="{StaticResource PillButton}" Width="190" Height="42" Margin="0,0,8,8" Tag="3" Click="Theme_Click"/>
                    <Button x:Name="Theme4" Style="{StaticResource PillButton}" Width="190" Height="42" Margin="0,0,8,8" Tag="4" Click="Theme_Click"/>
                    <Button x:Name="Theme5" Style="{StaticResource PillButton}" Width="190" Height="42" Margin="0,0,8,8" Tag="5" Click="Theme_Click"/>
                    <Button x:Name="Theme7" Style="{StaticResource PillButton}" Width="190" Height="42" Margin="0,0,8,8" Tag="7" Click="Theme_Click"/>
                    <Button x:Name="Theme8" Style="{StaticResource PillButton}" Width="190" Height="42" Margin="0,0,8,8" Tag="8" Click="Theme_Click"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Grid.Row="3" CornerRadius="20" Background="{DynamicResource CardBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                      Padding="18,14" Margin="0,12,0,0">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F464;" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LblAccountCap" FontWeight="Bold" FontSize="15" Margin="8,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                  </StackPanel>
                  <TextBlock x:Name="LblAccountName" FontSize="13" Margin="0,10,0,0"
                             Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                  <TextBlock x:Name="LblExportCodeCap" FontSize="12.5" Margin="6,10,0,4"
                             Foreground="{DynamicResource SubBrush}"/>
                  <Border CornerRadius="14" Background="{DynamicResource FieldBrush}"
                          BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" Padding="14,0">
                    <TextBox x:Name="FExportCode" Background="Transparent" BorderThickness="0" Height="42"
                             VerticalContentAlignment="Center" FlowDirection="LeftToRight"
                             Foreground="{DynamicResource FieldFgBrush}"/>
                  </Border>
                  <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="BtnBackupExport" Style="{StaticResource PillButton}" MinWidth="150" Height="42" Padding="14,0" Margin="0,0,8,8" Click="BtnBackupExport_Click"/>
                    <Button x:Name="BtnRotateRecovery" Style="{StaticResource PillButton}" MinWidth="150" Height="42" Padding="14,0" Margin="0,0,8,8" Click="BtnRotateRecovery_Click"/>
                    <Button x:Name="BtnLogout" Style="{StaticResource PillButton}" MinWidth="130" Height="42" Padding="14,0" Margin="0,0,8,8" Click="BtnLogout_Click"/>
                    <Button x:Name="BtnHistory" Style="{StaticResource PillButton}" MinWidth="150" Height="42" Padding="14,0" Margin="0,0,8,8" Click="BtnHistory_Click"/>
                  </WrapPanel>
                  <TextBlock x:Name="LblBackupHint" FontSize="12" Margin="6,8,0,0" LineHeight="20"
                             LineStackingStrategy="BlockLineHeight"
                             Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </Grid>

          </Grid>
        </ScrollViewer>

        <!-- Log console -->
        <Border Grid.Row="2" CornerRadius="18" Background="{DynamicResource ConsoleBrush}"
                Padding="12,10" Margin="0,12,0,0" MaxHeight="130">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
              <Ellipse Width="8" Height="8" Fill="{DynamicResource ConsoleFgBrush}"
                       Opacity="0.8" VerticalAlignment="Center"/>
              <TextBlock Text="LOG" FontFamily="Consolas" FontSize="11" Margin="8,0,0,0"
                         VerticalAlignment="Center" Opacity="0.7"
                         Foreground="{DynamicResource ConsoleFgBrush}"/>
            </StackPanel>
            <TextBox x:Name="TxtLog" Grid.Row="1" Background="Transparent" BorderThickness="0" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource ConsoleFgBrush}"
                     VerticalScrollBarVisibility="Auto"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
   </Border>

    <!-- ══ Auth gate overlay (fullscreen, edge-to-edge) ══ -->
    <Grid x:Name="AuthOverlay"
          Background="{DynamicResource WindowBrush}" Visibility="Visible">
        <ScrollViewer x:Name="AuthScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Border CornerRadius="0" Background="{DynamicResource CardBrush}"
                  BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0"
                  Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  MinHeight="{Binding ViewportHeight, ElementName=AuthScroll}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="38*" MinWidth="260"/>
                <ColumnDefinition Width="62*" MinWidth="320"/>
              </Grid.ColumnDefinitions>
              <!-- Deco panel -->
              <Border x:Name="DecoPanel" Grid.Column="0" CornerRadius="0" Padding="24,28">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#9C2B66" Offset="0"/>
                    <GradientStop Color="#5E1240" Offset="0.55"/>
                    <GradientStop Color="#3D0B2B" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="✦ StegaSuite" FontSize="18" FontWeight="Bold"
                             HorizontalAlignment="Center" Foreground="White"/>
                  <TextBlock x:Name="LblDecoTitle" FontSize="22" FontWeight="Bold" Margin="0,14,0,0"
                             HorizontalAlignment="Center" TextAlignment="Center"
                             Foreground="White" TextWrapping="Wrap"/>
                  <TextBlock x:Name="LblDecoCap" FontSize="12.5" Margin="0,8,0,26" LineHeight="20"
                             LineStackingStrategy="BlockLineHeight" TextAlignment="Center"
                             HorizontalAlignment="Center" Opacity="0.85"
                             Foreground="White" TextWrapping="Wrap"/>
                  <Button x:Name="BtnTabSwitch" Style="{StaticResource PillButton}" Height="44"
                          Background="White" Foreground="#911F51" Click="BtnTabSwitch_Click"/>
                </StackPanel>
              </Border>
              <!-- Form panel -->
              <StackPanel Grid.Column="1" Margin="34,28" VerticalAlignment="Center"
                          HorizontalAlignment="Center" MaxWidth="620" MinWidth="280">
                <Border Width="84" Height="84" CornerRadius="42" HorizontalAlignment="Center"
                        Background="{DynamicResource AccentBrush}">
                  <Image Source="Assets/raccoon.png" Width="84" Height="84" Stretch="UniformToFill">
                    <Image.Clip>
                      <EllipseGeometry Center="42,42" RadiusX="42" RadiusY="42"/>
                    </Image.Clip>
                  </Image>
                </Border>
                <TextBlock x:Name="LblAuthTitle" FontSize="22" FontWeight="Bold" Margin="0,12,0,0"
                           HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"
                           TextWrapping="Wrap" TextAlignment="Center"/>
                <StackPanel x:Name="AuthFormBox" Margin="0,20,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#x1F464;" FontSize="18" Margin="0,0,10,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource SubBrush}"/>
                    <TextBox x:Name="FAuthUser" KeyDown="AuthEnter_KeyDown" Grid.Column="1" Background="Transparent" BorderThickness="0"
                             Height="40" VerticalContentAlignment="Center" FlowDirection="LeftToRight"
                             FontSize="14" Foreground="{DynamicResource FieldFgBrush}"/>
                  </Grid>
                  <Border Height="1" Background="{DynamicResource FieldBorderBrush}" Margin="0,2,0,0"/>
                  <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#x1F511;" FontSize="18" Margin="0,0,10,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource SubBrush}"/>
                    <PasswordBox x:Name="FAuthPass" KeyDown="AuthEnter_KeyDown" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                 Height="40" VerticalContentAlignment="Center" FontSize="14"
                                 Foreground="{DynamicResource FieldFgBrush}"/>
                  </Grid>
                  <Border Height="1" Background="{DynamicResource FieldBorderBrush}" Margin="0,2,0,0"/>
                  <StackPanel x:Name="AuthPass2Box" Visibility="Collapsed">
                    <Grid Margin="0,14,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="&#x1F511;" FontSize="18" Margin="0,0,10,0"
                                 VerticalAlignment="Center" Foreground="{DynamicResource SubBrush}"/>
                      <PasswordBox x:Name="FAuthPass2" KeyDown="AuthEnter_KeyDown" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                   Height="40" VerticalContentAlignment="Center" FontSize="14"
                                   Foreground="{DynamicResource FieldFgBrush}"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource FieldBorderBrush}" Margin="0,2,0,0"/>
                  </StackPanel>
                  <TextBlock x:Name="LblAuthErr" FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap"
                             Foreground="#E5484D" Visibility="Collapsed"/>
                  <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnAuthForgot" Grid.Column="0" Style="{StaticResource PillButton}"
                            Height="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Background="Transparent" Foreground="{DynamicResource LinkBrush}"
                            Click="BtnAuthForgot_Click"/>
                    <Button x:Name="BtnAuthGo" Grid.Column="1" Style="{StaticResource PillButton}"
                            MinWidth="140" Height="44" Padding="20,0" Margin="8,0,0,0" FontSize="15"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource AccentFgBrush}" Click="BtnAuthGo_Click"/>
                  </Grid>
                  <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="1" VerticalAlignment="Center"
                            Background="{DynamicResource FieldBorderBrush}"/>
                    <TextBlock x:Name="LblOrCap" Grid.Column="1" Margin="10,0" FontSize="12"
                               VerticalAlignment="Center" Foreground="{DynamicResource SubBrush}"/>
                    <Border Grid.Column="2" Height="1" VerticalAlignment="Center"
                            Background="{DynamicResource FieldBorderBrush}"/>
                  </Grid>
                  <Button x:Name="BtnGoogle" Style="{StaticResource PillButton}" Height="46"
                          Margin="0,12,0,0" Click="BtnGoogle_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="G" FontSize="20" FontWeight="Bold" VerticalAlignment="Center">
                        <TextBlock.Foreground>
                          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4285F4" Offset="0"/>
                            <GradientStop Color="#EA4335" Offset="0.38"/>
                            <GradientStop Color="#FBBC05" Offset="0.62"/>
                            <GradientStop Color="#34A853" Offset="1"/>
                          </LinearGradientBrush>
                        </TextBlock.Foreground>
                      </TextBlock>
                      <TextBlock Text="Google" FontSize="14" FontWeight="Bold" Margin="10,0,0,0"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="BtnGoogleSetup" Style="{StaticResource PillButton}" Height="36"
                          Margin="0,8,0,0" Background="Transparent"
                          Foreground="{DynamicResource LinkBrush}" Visibility="Collapsed"
                          Click="BtnGoogleSetup_Click"/>
                  <TextBlock x:Name="LblGoogleStep" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                             Foreground="{DynamicResource SubBrush}" Visibility="Collapsed"
                             HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="AuthRestoreBox" Margin="0,20,0,0" Visibility="Collapsed">
                  <Button x:Name="BtnAuthPick" Style="{StaticResource PillButton}" Height="42"
                          Click="BtnAuthPick_Click"/>
                  <TextBlock x:Name="LblAuthFile" FontSize="12" Margin="6,8,0,0" MinHeight="16"
                             Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap"/>
                  <TextBlock x:Name="LblRecCodeCap" FontSize="12.5" Margin="6,10,0,4"
                             Foreground="{DynamicResource SubBrush}"/>
                  <Border CornerRadius="14" Background="{DynamicResource FieldBrush}"
                          BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" Padding="14,0">
                    <TextBox x:Name="FAuthRecovery" KeyDown="AuthEnter_KeyDown" Background="Transparent" BorderThickness="0" Height="42"
                             VerticalContentAlignment="Center" FlowDirection="LeftToRight"
                             Foreground="{DynamicResource FieldFgBrush}"/>
                  </Border>
                  <TextBlock x:Name="LblNewPassCap" FontSize="12.5" Margin="6,10,0,4"
                             Foreground="{DynamicResource SubBrush}"/>
                  <Border CornerRadius="14" Background="{DynamicResource FieldBrush}"
                          BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" Padding="14,0">
                    <PasswordBox x:Name="FAuthNew1" KeyDown="AuthEnter_KeyDown" Background="Transparent" BorderThickness="0" Height="42"
                                 VerticalContentAlignment="Center" Foreground="{DynamicResource FieldFgBrush}"/>
                  </Border>
                  <TextBlock x:Name="LblNewPass2Cap" FontSize="12.5" Margin="6,10,0,4"
                             Foreground="{DynamicResource SubBrush}"/>
                  <Border CornerRadius="14" Background="{DynamicResource FieldBrush}"
                          BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" Padding="14,0">
                    <PasswordBox x:Name="FAuthNew2" KeyDown="AuthEnter_KeyDown" Background="Transparent" BorderThickness="0" Height="42"
                                 VerticalContentAlignment="Center" Foreground="{DynamicResource FieldFgBrush}"/>
                  </Border>
                  <Button x:Name="BtnAuthRestore" Style="{StaticResource PillButton}" Height="50" FontSize="15"
                          Margin="0,14,0,0" Background="{DynamicResource AccentBrush}"
                          Foreground="{DynamicResource AccentFgBrush}" Click="BtnAuthRestore_Click"/>
                  <Button x:Name="BtnBackToLogin" Style="{StaticResource PillButton}" Height="36"
                          Margin="0,8,0,0" Background="Transparent"
                          Foreground="{DynamicResource LinkBrush}" Click="BtnBackToLogin_Click"/>
                </StackPanel>
                <StackPanel x:Name="AuthCodeBox" Margin="0,20,0,0" Visibility="Collapsed">
                  <TextBlock x:Name="LblCodeCap" FontSize="13" LineHeight="22"
                             LineStackingStrategy="BlockLineHeight"
                             Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                  <Border CornerRadius="14" Background="{DynamicResource FieldBrush}"
                          BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1"
                          Margin="0,10,0,0" Padding="14,10">
                    <TextBox x:Name="LblRecoveryCode" Background="Transparent" BorderThickness="0"
                             IsReadOnly="True" FlowDirection="LeftToRight" FontSize="17" FontWeight="Bold"
                             HorizontalContentAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                  </Border>
                  <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnCopyCode" Grid.Column="0" Style="{StaticResource PillButton}"
                            Height="44" Margin="0,0,4,0" Click="BtnCopyCode_Click"/>
                    <Button x:Name="BtnAuthContinue" Grid.Column="1" Style="{StaticResource PillButton}"
                            Height="44" Margin="4,0,0,0" Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource AccentFgBrush}" Click="BtnAuthContinue_Click"/>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
        </ScrollViewer>
      </Grid>
  </Grid>
</Window>
