<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Graphite (dark monochrome + amber accent). Light text on dark surfaces. -->
  <SolidColorBrush x:Key="WindowBrush" Color="#101216"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#171A20"/>
  <SolidColorBrush x:Key="CardBrush" Color="#20242C"/>
  <SolidColorBrush x:Key="CardBorderBrush" Color="#3A404B"/>
  <SolidColorBrush x:Key="TextBrush" Color="#F4F5F7"/>
  <SolidColorBrush x:Key="SubBrush" Color="#A7AEB9"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="#121419"/>
  <SolidColorBrush x:Key="SideIconBrush" Color="#6E7683"/>
  <SolidColorBrush x:Key="SideSelectedBrush" Color="#E8A33D"/>
  <SolidColorBrush x:Key="SideSelectedIconBrush" Color="#1A1405"/>
  <SolidColorBrush x:Key="LogoBrush" Color="#E8A33D"/>
  <SolidColorBrush x:Key="LogoFgBrush" Color="#1A1405"/>
  <SolidColorBrush x:Key="PillBrush" Color="#2A2F38"/>
  <SolidColorBrush x:Key="PillFgBrush" Color="#F4F5F7"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#E8A33D"/>
  <SolidColorBrush x:Key="AccentFgBrush" Color="#1A1405"/>
  <SolidColorBrush x:Key="FieldBrush" Color="#14171C"/>
  <SolidColorBrush x:Key="FieldBorderBrush" Color="#3A404B"/>
  <SolidColorBrush x:Key="FieldFgBrush" Color="#F4F5F7"/>
  <SolidColorBrush x:Key="ConsoleBrush" Color="#0A0B0E"/>
  <SolidColorBrush x:Key="ConsoleFgBrush" Color="#8DF0A0"/>
  <SolidColorBrush x:Key="LinkBrush" Color="#F0C060"/>
  <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#2A2F38" Offset="0"/>
    <GradientStop Color="#171A20" Offset="1"/>
  </LinearGradientBrush>
</ResourceDictionary>
